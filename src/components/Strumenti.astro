---
import { strumenti } from '../data/strumenti';
---

<section class="section section--strumenti" aria-label="I nostri strumenti">
  <div class="wrap wrap--wide">
    <p class="eyebrow eyebrow--centro reveal">I nostri strumenti</p>

    <div class="fascia-str reveal">
      <div class="loghi-pista">
        <ul class="loghi loghi--scorre">
          {
            strumenti.map((s) => (
              <li class="logo-str">
                <img src={s.src} alt={s.nome} width="120" height="40" decoding="async" />
              </li>
            ))
          }
        </ul>
        <ul class="loghi loghi--scorre" aria-hidden="true">
          {
            strumenti.map((s) => (
              <li class="logo-str">
                <img src={s.src} alt={s.nome} width="120" height="40" decoding="async" />
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .section--strumenti {
    padding-bottom: var(--s-6);
  }
  .eyebrow--centro {
    text-align: center;
  }
  .fascia-str {
    margin-top: var(--s-3);
    padding: var(--s-4) var(--s-3);
    background: var(--bg-soft);
    border-radius: var(--r-lg);
    overflow: hidden;
    position: relative;
    padding-inline: 0;
  }
  .loghi {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 14px 22px;
    list-style: none;
  }
  .logo-str {
    display: flex;
    align-items: center;
  }
  /* I loghi restano nel loro colore: quasi tutte le linee guida dei
     marchi vietano di alterarlo, scala di grigi compresa. */
  .logo-str img {
    display: block;
    height: 38px;
    width: 38px;
    object-fit: contain;
  }

  /* Due piste identiche affiancate che traslano insieme: quando la prima
     è uscita, la seconda è esattamente dove stava lei, senza salti. */
  .loghi-pista {
    display: flex;
    width: max-content;
  }
  .loghi--scorre {
    flex-wrap: nowrap;
    justify-content: flex-start;
    animation: scorri-str 48s linear infinite;
    padding-inline: 11px;
  }
  @keyframes scorri-str {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-100%);
    }
  }
  .fascia-str:hover .loghi--scorre {
    animation-play-state: paused;
  }
  @media (prefers-reduced-motion: reduce) {
    .loghi--scorre {
      animation: none;
    }
    .loghi-pista {
      width: auto;
      flex-wrap: wrap;
      justify-content: center;
    }
  }
  .fascia-str::before,
  .fascia-str::after {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    width: clamp(30px, 5vw, 80px);
    z-index: 2;
    pointer-events: none;
  }
  .fascia-str::before {
    left: 0;
    background: linear-gradient(90deg, var(--bg-soft), rgba(244, 245, 241, 0));
  }
  .fascia-str::after {
    right: 0;
    background: linear-gradient(270deg, var(--bg-soft), rgba(244, 245, 241, 0));
  }
</style>
