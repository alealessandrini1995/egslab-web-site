---
import { getCollection } from 'astro:content';
import ArtCard from './ArtCard.astro';
import { perData, dataItaliana } from '../lib/blog';

const articoli = perData(await getCollection('blog')).slice(0, 3);
---

<section class="section" aria-labelledby="titolo-blog">
  <div class="wrap wrap--wide">
    <div class="head head--center reveal">
      <p class="eyebrow">Dal blog</p>
      <h2 class="h2" id="titolo-blog">
        <span class="riga">Quello che ci chiedono,</span>
        <span class="riga grad">spiegato per bene</span>
      </h2>
    </div>

    <div class="giornale reveal">
      {
        articoli.map((a) => (
          <ArtCard
            href={`/blog/${a.id}/`}
            categoria={a.data.category}
            data={dataItaliana(a.data.date)}
            titolo={a.data.title}
            excerpt={a.data.excerpt}
            tempo={a.data.readingTime}
            img={a.data.coverCard}
          />
        ))
      }
    </div>

    <div class="giornale__coda reveal">
      <a class="btn btn--green" href="/blog/">Leggi tutti gli articoli</a>
    </div>
  </div>
</section>

<style>
  .giornale {
    margin-top: var(--s-5);
    display: grid;
    gap: var(--s-4);
    max-width: var(--wrap);
    margin-inline: auto;
    border-top: 1px solid var(--hairline);
    padding-top: var(--s-4);
  }
  @media (min-width: 900px) {
    .giornale {
      grid-template-columns: repeat(3, 1fr);
      column-gap: var(--s-5);
    }
    /* Il filo sta nel vuoto fra le colonne, disegnato dall'articolo e non
       come border-left con un padding: con il padding le colonne 2 e 3
       perderebbero larghezza utile. */
    .giornale :global(.art + .art)::before {
      content: '';
      position: absolute;
      left: calc(var(--s-5) / -2);
      top: 0;
      bottom: 0;
      width: 1px;
      background: var(--hairline);
    }
  }

  .giornale__coda {
    display: flex;
    justify-content: center;
    margin-top: var(--s-5);
  }

  .h2 :global(.riga) {
    display: block;
  }
  .h2 :global(.riga + .riga) {
    margin-top: 0.06em;
  }
</style>
