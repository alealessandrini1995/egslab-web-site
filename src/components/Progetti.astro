---
import { progetti } from '../data/progetti';
import { Image } from 'astro:assets';
import { withBase } from '../lib/url';
---

<section class="section" aria-labelledby="titolo-progetti">
  <div class="wrap wrap--wide">
    <div class="head head--largo reveal">
      <p class="eyebrow">Progetti in evidenza</p>
      <h2 class="h2" id="titolo-progetti">Alcuni progetti <span class="grad">di cui andiamo fieri</span></h2>
    </div>

    <div class="folio reveal" data-folio>
      <div class="folio__vetrina">
        <div class="folio__pista" data-folio-pista>
          {
            progetti.map((p, i) => (
              <article class="caso" aria-hidden={i !== 0}>
                <div class="caso__palco">
                  <svg class="caso__mark" viewBox="-120 -60 4439 1637" aria-hidden="true">
                    <use href="#logo-egslab" />
                  </svg>
                  <div class={`caso__cover${p.copertinaFoto ? ' caso__cover--foto' : ''}`} style={`--fondo:${p.fondo}`}>
                    <Image src={p.img} alt="" width={1050} height={600} loading="lazy" />
                  </div>
                </div>
                <div class="caso__testo">
                  <h3 class="caso__tit">{p.titolo}</h3>
                  <p class="caso__meta">
                    <b>{p.cliente}</b>
                    <br />
                    {p.categoria}
                  </p>
                  <p class="caso__frase">{p.frase}</p>
                  <p class="caso__cta">
                    <a class="btn btn--ghost" href={withBase('/portfolio/')}>Scopri il progetto</a>
                  </p>
                </div>
              </article>
            ))
          }
        </div>
      </div>

      <div class="folio__nav">
        <button class="rail-btn" type="button" data-folio-vai="prec" aria-label="Progetto precedente">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 15l6-6 6 6"></path></svg>
        </button>
        <p class="folio__conta" data-folio-conta aria-live="polite">01 / 05</p>
        <button class="rail-btn" type="button" data-folio-vai="succ" aria-label="Progetto successivo">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9l6 6 6-6"></path></svg>
        </button>
      </div>
    </div>

    <div class="section-foot reveal" style="text-align:left">
      <a class="link" href={withBase('/portfolio/')}>Vedi tutto il portfolio</a>
    </div>
  </div>
</section>

<script>
  (function vetrinaProgetti() {
    const folio = document.querySelector<HTMLElement>('[data-folio]');
    if (!folio) return;

    const pista = folio.querySelector<HTMLElement>('[data-folio-pista]');
    const casi = Array.from(folio.querySelectorAll<HTMLElement>('.caso'));
    const conta = folio.querySelector<HTMLElement>('[data-folio-conta]');
    if (!pista || casi.length < 2) return;

    let i = 0;
    function due(n: number) {
      return (n < 10 ? '0' : '') + n;
    }

    function mostra(n: number) {
      i = (n + casi.length) % casi.length;
      pista!.style.transform = `translateY(${-i * 100}%)`;
      casi.forEach((c, k) => {
        c.setAttribute('aria-hidden', String(k !== i));
        c.querySelectorAll<HTMLElement>('a, button').forEach((f) => {
          if (k === i) f.removeAttribute('tabindex');
          else f.setAttribute('tabindex', '-1');
        });
      });
      if (conta) conta.textContent = `${due(i + 1)} / ${due(casi.length)}`;
    }

    folio.querySelectorAll<HTMLButtonElement>('[data-folio-vai]').forEach((b) => {
      b.addEventListener('click', () => mostra(b.dataset.folioVai === 'succ' ? i + 1 : i - 1));
      b.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowDown') {
          e.preventDefault();
          mostra(i + 1);
        } else if (e.key === 'ArrowUp') {
          e.preventDefault();
          mostra(i - 1);
        }
      });
    });

    mostra(0);
  })();
</script>

<style>
  .folio {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: var(--s-3);
    align-items: center;
    margin-top: var(--s-5);
  }
  .folio__vetrina {
    position: relative;
    overflow: hidden;
    height: clamp(360px, 44vh, 470px);
  }
  .folio__pista {
    display: flex;
    flex-direction: column;
    height: 100%;
    transition: transform var(--t-slow) var(--ease);
  }

  .caso {
    flex: 0 0 100%;
    height: 100%;
    display: grid;
    gap: var(--s-4);
    align-items: center;
  }
  @media (min-width: 980px) {
    .caso {
      grid-template-columns: 0.9fr 1.1fr;
      gap: var(--s-5);
    }
  }

  .caso__palco {
    position: relative;
    height: 100%;
    border-radius: var(--r-lg);
    background: var(--sage);
    overflow: hidden;
    padding: var(--s-4);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--s-3);
  }
  /* Il marchio è una firma, non una filigrana: piccolo, orizzontale,
     bianco — bianco è la regola di marca sul sage, e la WCAG 1.4.3
     esclude i marchi dalla soglia di contrasto. */
  .caso__mark {
    flex: 0 0 auto;
    width: 104px;
    height: auto;
    fill: #fff;
    opacity: 0.95;
    pointer-events: none;
  }

  /* 7:4 come i loghi clienti (1050×600): una copertina vera e un logo
     sono lo stesso file. */
  .caso__cover {
    position: relative;
    z-index: 2;
    width: min(100%, 420px);
    aspect-ratio: 7 / 4;
    border-radius: var(--r-md);
    background: var(--fondo, #0c0e0c);
    display: grid;
    place-items: center;
    box-shadow: var(--shadow-md);
    overflow: hidden;
  }
  /* contain: il logo è 7:4 dentro una card 3:4 — con cover si perderebbe
     più di metà del logo */
  .caso__cover :global(img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 9%;
  }
  .caso__cover--foto :global(img) {
    object-fit: cover;
    padding: 0;
  }

  .caso__tit {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--fs-h2);
    line-height: 1.05;
    letter-spacing: var(--tracking-title);
    color: var(--ink);
    text-wrap: balance;
  }
  .caso__meta {
    margin-top: var(--s-2);
    color: var(--ink-soft);
    line-height: 1.5;
  }
  .caso__meta b {
    color: var(--ink);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-size: 15px;
  }
  .caso__frase {
    margin-top: var(--s-3);
    color: var(--ink-soft);
    font-size: var(--fs-lead);
    line-height: 1.6;
    max-width: 52ch;
  }
  .caso__cta {
    margin-top: var(--s-4);
  }

  .folio__nav {
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
    align-items: center;
  }
  .folio__conta {
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--ink-soft);
    margin-block: 6px;
  }
  .folio__nav .rail-btn {
    width: 46px;
    height: 46px;
    border-radius: 50%;
    cursor: pointer;
    display: grid;
    place-items: center;
    font-size: 0;
    color: var(--ink);
    background: #fff;
    border: 1px solid var(--hairline);
    box-shadow: var(--shadow-sm);
    transition: transform var(--t-fast);
  }
  .folio__nav .rail-btn:hover {
    transform: translateY(-2px);
  }
  .folio__nav .rail-btn svg {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  @media (max-width: 979px) {
    .folio {
      grid-template-columns: 1fr;
    }
    .folio__vetrina {
      height: clamp(560px, 78vh, 760px);
    }
    .caso {
      grid-template-rows: auto auto;
      align-content: start;
    }
    .caso__palco {
      height: auto;
      aspect-ratio: 4 / 3;
    }
    .folio__nav {
      flex-direction: row;
      justify-content: center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .folio__pista {
      transition: none;
    }
  }
</style>
