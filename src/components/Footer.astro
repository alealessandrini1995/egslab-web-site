---
import { site } from '../config/site';
import { servizi } from '../data/servizi';
import Socials from './Socials.astro';
import qrBiglietto from '../assets/images/qr-biglietto-virtuale.webp';
import { Image } from 'astro:assets';
import { withBase } from '../lib/url';

const menu = [{ label: 'Home', href: '/' }, ...site.nav];
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <canvas class="site-footer__canvas" data-canvas="footer" aria-hidden="true"></canvas>

  <div class="wrap wrap--wide">
    <div class="footer-grid">
      <div class="fcard fcard--brand fcard--fascia">
        <span class="footer-brand__badge">
          <svg class="brand__logo" viewBox="-120 -60 4439 1637" width="65" height="24" role="img" aria-label="egslab">
            <use href="#logo-egslab"></use>
          </svg>
        </span>
        <p>
          Chiavari (GE), 16043<br />
          <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a>
        </p>
        <p><a class="link" href={site.contact.whatsapp} target="_blank" rel="noopener">Scrivici su WhatsApp</a></p>
      </div>

      <div class="fcard fcard--fascia">
        <h3>Servizi</h3>
        <ul class="fcard__cols fcard__cols--srv">
          {
            servizi.map((s) => (
              <li>
                <a href={withBase(`/servizi/${s.slug}/`)}>{s.nome}</a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="fcard fcard--fascia">
        <h3>Menù</h3>
        <ul class="fcard__cols fcard__cols--menu">
          {
            menu.map((item) => (
              <li>
                <a href={withBase(item.href)}>{item.label}</a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="fcard fcard--qr">
        <h3>Biglietto da visita virtuale</h3>
        <p>Inquadralo con lo smartphone.</p>
        <div class="qr-slot">
          <Image class="qr-slot__img" src={qrBiglietto} alt="Codice QR del biglietto da visita virtuale di egslab" width={490} height={490} loading="lazy" />
        </div>
        <p>oppure <a class="link" href={withBase('/contatti/')}>aprilo qui</a></p>
        <Socials class="fcard__social" />
      </div>
    </div>

    <div class="footer-bottom">
      <p>© {year} egslab — laboratorio digitale · Chiavari (GE) · Liguria · Lavoriamo in tutta Italia</p>
      <p><a href={withBase('/privacy/')}>Privacy</a> · <a href={withBase('/cookie/')}>Cookie</a></p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    overflow: hidden;
    background: var(--night);
    color: #fff;
    /* Nessun raggio, come l'hero: il piè di pagina è largo quanto lo
       schermo, gli angoli alti squadrati diventano una linea d'orizzonte
       netta contro il bianco invece che due angoli a 90 gradi. */
    border-radius: 0;
    margin-top: var(--sp-fuori);
    padding-block: var(--sp-dentro) var(--s-4);
  }
  .site-footer__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    opacity: 0.45;
  }
  .site-footer > .wrap {
    position: relative;
    z-index: 2;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--s-2);
  }
  @media (min-width: 720px) {
    .footer-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1060px) {
    .footer-grid {
      grid-template-columns: 1fr 340px;
      align-items: stretch;
    }
    .footer-grid > .fcard--qr {
      grid-column: 2;
      grid-row: 1 / span 3;
    }
  }

  .fcard {
    padding: var(--s-4);
    border-radius: var(--r-md);
    background: var(--glass-dark-2);
    border: 1px solid var(--glass-brd-d);
    backdrop-filter: var(--blur);
    -webkit-backdrop-filter: var(--blur);
  }
  .fcard h3 {
    font-size: 14px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #fff;
    margin-bottom: var(--s-3);
  }
  .fcard ul {
    list-style: none;
    display: grid;
    gap: 10px;
  }
  .fcard a {
    text-decoration: none;
    font-size: var(--fs-small);
    color: rgba(255, 255, 255, 0.82);
  }
  /* :not(.link): senza, questa riga colpirebbe anche i link con la
     freccia, sommando una sottolineatura statica alla riga animata che
     .link disegna già da sé. */
  .fcard a:not(.link):hover {
    color: #fff;
    text-decoration: underline;
  }
  .fcard p {
    font-size: var(--fs-small);
    color: rgba(255, 255, 255, 0.78);
  }

  .fcard--fascia {
    padding: var(--s-3) var(--s-4);
  }
  @media (min-width: 1060px) {
    .fcard--fascia {
      display: grid;
      grid-template-columns: 150px 1fr;
      gap: var(--s-3);
      align-items: start;
    }
    .fcard--fascia > h3 {
      margin-bottom: 0;
      padding-top: 4px;
    }
  }

  /* Il numero di colonne non si scrive: si scrive quante righe deve avere
     l'elenco, le colonne vengono di conseguenza — così l'ordine di
     lettura resta verticale. */
  .fcard__cols {
    gap: 10px var(--s-3);
  }
  @media (min-width: 1060px) {
    .fcard__cols {
      grid-auto-flow: column;
      grid-auto-columns: 1fr;
    }
    .fcard__cols--srv {
      grid-template-rows: repeat(5, auto);
    }
    .fcard__cols--menu {
      grid-template-rows: repeat(2, auto);
    }
  }

  .fcard--brand {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
  }
  @media (min-width: 1060px) {
    .fcard--brand {
      display: grid;
      grid-template-columns: auto 1fr auto;
      align-items: center;
      gap: var(--s-3) var(--s-4);
    }
    .fcard--brand > p {
      margin: 0;
    }
  }
  .footer-brand__badge {
    display: inline-grid;
    place-items: center;
    height: 48px;
    padding-inline: 20px;
    background: var(--sage);
    border-radius: var(--r-pill);
    align-self: flex-start;
  }

  /* Card del biglietto virtuale: la placca bianca sotto al QR non è
     decorazione, il QR ha i moduli scuri su fondo trasparente. */
  .fcard--qr {
    display: flex;
    flex-direction: column;
  }
  .qr-slot {
    aspect-ratio: 1;
    border-radius: var(--r-sm);
    background: #fff;
    width: min(100%, 280px);
    overflow: hidden;
    padding: 10px;
    margin-block: var(--s-2);
  }
  .qr-slot :global(img) {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: contain;
  }
  /* margin-top:auto incolla i social in fondo, qualunque sia l'altezza
     della colonna, così restano allineati al bordo basso delle fasce. */
  .fcard--qr :global(.fcard__social) {
    margin-top: auto;
    padding-top: var(--s-3);
  }

  .footer-bottom {
    margin-top: var(--s-2);
    padding: var(--s-3) var(--s-4);
    border-radius: var(--r-pill);
    background: var(--glass-dark-2);
    border: 1px solid var(--glass-brd-d);
    backdrop-filter: var(--blur);
    -webkit-backdrop-filter: var(--blur);
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
    justify-content: space-between;
    align-items: center;
    font-size: 13px;
    color: rgba(255, 255, 255, 0.8);
  }
</style>
