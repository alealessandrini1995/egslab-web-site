---
import { site } from '../config/site';
---

<section class="hero">
  <canvas
    class="hero__canvas"
    data-canvas="hero"
    aria-hidden="true"
    data-fondo="#FFFFFF"
    data-scia="rgba(255,255,255,.055)"
    data-linee="rgba(146,176,121,.70)|rgba(65,105,53,.58)"
  ></canvas>

  <div class="hero__inner">
    <div class="wrap wrap--wide">
      <div class="hero__card glass glass--light">
        <h1 class="h1">
          <span class="riga">Web agency per startup e brand in crescita:</span>
          <span class="riga grad">siti web, grafica, social e progetti digitali.</span>
        </h1>
        <p class="hero__sub">Più di una web agency: il laboratorio digitale che ti fa partire da zero.</p>
        <p class="hero__text">
          Se stai costruendo qualcosa — un'attività che apre, un brand che nasce, un progetto che finora è
          rimasto nella tua testa — ti serve qualcuno che parta dall'inizio insieme a te. Non un fornitore a
          cui consegnare un brief già pronto.
        </p>
        <div class="hero__cta">
          <a class="btn btn--green" href={site.contact.whatsapp} target="_blank" rel="noopener">Scrivici su WhatsApp</a>
          <a class="btn btn--ghost" href="/portfolio/">Guarda i nostri progetti</a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* L'hero deve chiudersi esattamente dove finisce lo schermo: svh e non vh,
     perché su mobile vh misura la finestra con la barra indirizzi già
     ritirata e il fondo resterebbe tagliato all'apertura. */
  .hero {
    position: relative;
    display: flex;
    align-items: center;
    overflow: hidden;
    min-height: 100vh;
    min-height: calc(100svh + var(--header-gap));
    border-radius: 0;
    margin-top: calc((var(--header-h) + var(--header-gap) * 2) * -1);
    padding-top: calc(var(--header-h) + var(--header-gap) * 2);
  }
  .hero__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    background: var(--bg);
  }
  /* velo: qualunque cosa passi nel fondo animato, il testo resta leggibile */
  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: radial-gradient(120% 82% at 50% 42%, rgba(255, 255, 255, 0), rgba(255, 255, 255, 0.4) 78%);
  }
  .hero__inner {
    position: relative;
    z-index: 5;
    width: 100%;
    color: var(--ink);
  }
  .hero__card {
    background: var(--glass-light);
    border: 1px solid var(--glass-brd-l);
    box-shadow: var(--shadow-md);
    border-radius: var(--r-xl);
    width: min(1000px, 100%);
    margin-inline: auto;
    text-align: center;
    padding: clamp(28px, 4.4vw, 64px) clamp(22px, 4vw, 56px);
  }
  .hero .h1 .riga {
    display: block;
  }
  .hero .h1 .riga + .riga {
    margin-top: 0.1em;
  }
  .hero__sub {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(18px, 2vw, 24px);
    line-height: 1.3;
    letter-spacing: -0.02em;
    margin-top: var(--s-3);
    color: var(--ink);
  }
  .hero__text {
    margin: var(--s-2) auto 0;
    max-width: 62ch;
    color: var(--ink-soft);
    font-size: clamp(16px, 1.5vw, 18px);
  }
  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
    justify-content: center;
    margin-top: var(--s-5);
  }

  @media (max-height: 700px) {
    .hero__card {
      padding-block: 6px;
    }
    .hero .h1 .riga + .riga {
      margin-top: 0;
    }
    .hero__sub {
      margin-top: 8px;
    }
    .hero__text {
      margin-top: 8px;
      font-size: 15px;
      line-height: 1.4;
    }
    .hero__cta {
      margin-top: 12px;
    }
  }
</style>
