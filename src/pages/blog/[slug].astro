---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArtCard from '../../components/ArtCard.astro';
import { correlati as trovaCorrelati, dataItaliana } from '../../lib/blog';
import { servizi } from '../../data/servizi';
import { Image } from 'astro:assets';

export async function getStaticPaths() {
  const articoli = await getCollection('blog');
  return articoli.map((articolo) => ({
    params: { slug: articolo.id },
    props: { articolo, tutti: articoli },
  }));
}

const { articolo, tutti } = Astro.props;
const { Content } = await render(articolo);
const servizio = servizi.find((s) => s.slug === articolo.data.servizio)!;
const correlati = trovaCorrelati(tutti, articolo);
---

<BaseLayout title={articolo.data.seoTitle} description={articolo.data.description} image={articolo.data.cover?.src}>
  <article class="section art-pagina" aria-labelledby="titolo-articolo">
    <div class="wrap">
      <nav class="briciole" aria-label="Dove ti trovi">
        <ol>
          <li><a href="/">Home</a></li>
          <li><a href="/blog/">Blog</a></li>
          <li aria-current="page">{articolo.data.shortTitle}</li>
        </ol>
      </nav>

      <div class="art-testa">
        <p class="prosa__occhiello">{articolo.data.category}</p>
        <h1 class="h1 art-testa__titolo" id="titolo-articolo">{articolo.data.title}</h1>
        <p class="art-testa__lead">{articolo.data.lead}</p>
        <p class="art-testa__meta"><time datetime={articolo.data.date.toISOString()}>{dataItaliana(articolo.data.date)}</time> · {articolo.data.readingTime}</p>
      </div>

      <div class="art-cover">
        {
          articolo.data.cover ? (
            <Image class="art-cover__img" src={articolo.data.cover} alt={articolo.data.title} width={1600} height={900} />
          ) : (
            <div class="art-cover__img" data-placeholder="Copertina 1600 × 900" />
          )
        }
      </div>

      <div class="prosa">
        <Content />

        <div class="prosa__servizio">
          <p class="prosa__servizio-et">Il servizio di cui parla questo articolo</p>
          <p class="prosa__servizio-nome">
            <a class="link" href={`/servizi/${servizio.slug}/`}>{servizio.nome}</a>
          </p>
        </div>

        <div class="art-ritorno">
          <a class="btn btn--ghost" href="/blog/">Torna a tutti gli articoli</a>
        </div>
      </div>
    </div>
  </article>

  {
    correlati.length > 0 && (
      <section class="section" aria-labelledby="titolo-correlati">
        <div class="wrap wrap--wide">
          <div class="head head--center">
            <p class="eyebrow">Dalla stessa categoria</p>
            <h2 class="h2 h3" id="titolo-correlati">
              Altri articoli su <span class="grad">{articolo.data.category}</span>
            </h2>
          </div>
          <div class={`giornale giornale--${correlati.length}`}>
            {correlati.map((a) => (
              <ArtCard
                href={`/blog/${a.id}/`}
                categoria={a.data.category}
                data={dataItaliana(a.data.date)}
                titolo={a.data.title}
                excerpt={a.data.excerpt}
                tempo={a.data.readingTime}
                img={a.data.coverCard}
              />
            ))}
          </div>
        </div>
      </section>
    )
  }
</BaseLayout>

<style>
  .art-pagina {
    padding-top: var(--s-5);
  }
  .art-pagina .wrap:not(.wrap--wide) {
    max-width: 820px;
  }

  .briciole ol {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    list-style: none;
    font-size: 13px;
    color: var(--ink-faint);
  }
  .briciole li + li::before {
    content: '/';
    margin-right: 8px;
    color: var(--hairline);
  }
  .briciole a {
    color: var(--ink-faint);
    text-underline-offset: 3px;
  }
  .briciole a:hover {
    color: var(--green);
  }

  .art-testa {
    margin-top: var(--s-4);
  }
  .prosa__occhiello {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 12px;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--green);
  }
  .art-testa__titolo {
    margin-top: 10px;
    font-size: clamp(30px, 4.2vw, 50px);
    line-height: 1.1;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }
  .art-testa__lead {
    margin-top: var(--s-3);
    font-size: var(--fs-lead);
    line-height: 1.55;
    color: var(--ink-soft);
  }
  .art-testa__meta {
    margin-top: var(--s-3);
    font-size: 13px;
    color: var(--ink-faint);
  }

  .art-cover {
    margin-top: var(--s-4);
    position: relative;
    aspect-ratio: 16 / 9;
    border-radius: var(--r-lg);
    overflow: hidden;
  }
  .art-cover :global(img),
  .art-cover__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    background: linear-gradient(155deg, #2c3a46, #3a3550 46%, #2f3b2c);
  }
  .art-cover__img[data-placeholder]::after {
    content: attr(data-placeholder);
    position: absolute;
    inset: auto 0 46% 0;
    text-align: center;
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.42);
  }

  .prosa {
    margin-top: var(--s-5);
    max-width: 68ch;
  }
  .prosa :global(p) {
    font-size: 17px;
    line-height: 1.72;
    color: var(--ink-soft);
  }
  .prosa :global(p + p) {
    margin-top: var(--s-3);
  }
  .prosa :global(strong) {
    color: var(--ink);
    font-weight: 600;
  }
  .prosa :global(h2) {
    margin-top: var(--s-5);
    color: var(--ink);
  }
  .prosa :global(h2 + p) {
    margin-top: var(--s-2);
  }
  .prosa :global(.prosa__nota) {
    margin-top: var(--s-3);
    padding: 14px 18px;
    border-left: 3px solid var(--sage);
    background: var(--bg-soft);
    border-radius: 0 var(--r-sm) var(--r-sm) 0;
  }

  .prosa__servizio {
    margin-top: var(--s-5);
    padding-top: var(--s-4);
    border-top: 1px solid var(--hairline);
  }
  .prosa__servizio-et {
    font-size: 13px;
    color: var(--ink-faint);
  }
  .prosa__servizio-nome {
    margin-top: 6px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 20px;
    letter-spacing: -0.02em;
  }

  .art-ritorno {
    margin-top: var(--s-4);
    display: flex;
    justify-content: center;
  }

  .giornale {
    margin-top: var(--s-5);
    display: grid;
    gap: var(--s-4);
  }
  @media (min-width: 900px) {
    .giornale {
      grid-template-columns: repeat(3, 1fr);
      column-gap: var(--s-5);
    }
    .giornale--1 {
      grid-template-columns: minmax(0, 420px);
      justify-content: center;
    }
    .giornale--2 {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      max-width: 820px;
      margin-inline: auto;
    }
  }
  .h3 :global(.grad) {
    display: inline;
  }
</style>
